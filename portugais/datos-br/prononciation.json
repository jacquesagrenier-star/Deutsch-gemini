     "api": "[i] · [u]",
     "court": {
      "fr": "le e final se dit « i », le o final « ou »"
     },
     "explication": {
      "fr": "En fin de mot sans accent, e se dit « i » et o se dit « ou » : leite « LÉÏ-tchi », sete « SÉ-tchi », carro « KA-hou », obrigado « o-bri-GA-dou »."
     },
