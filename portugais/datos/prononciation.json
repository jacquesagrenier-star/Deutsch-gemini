     "id": "e-avale",
     "graphie": "e (sans accent)",
     "api": "[ɨ] · muet",
     "court": {
      "fr": "le e sans accent s'avale"
     },
     "explication": {
      "fr": "C'est le trait le plus frappant du Portugal : un e sans accent se réduit à presque rien, un « e » très bref, souvent muet. telefone se dit « t'l'FON' », pequeno « p'KÉ-nou », noite « NOÏT' ». C'est pour cela que le portugais d'Europe semble « manger » les mots."
     },
     "exemples": [
      {
       "mot": "telefone",
       "traduction": "le téléphone"
      },
      {
       "mot": "pequeno",
       "traduction": "petit"
      },
      {
       "mot": "noite",
       "traduction": "la nuit"
      },
      {
       "mot": "sete",
       "traduction": "sept"
      },
      {
       "mot": "leite",
       "traduction": "le lait"
      },
