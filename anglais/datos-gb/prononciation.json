     "id": "i-court-long",
     "graphie": "i · ee · ea",
     "api": "[ɪ] · [iː]",
     "court": {
      "fr": "ship ≠ sheep : un i court, un i long"
     },
     "explication": {
      "fr": "Le français n'a qu'un i ; l'anglais en a deux. Le i court [ɪ] est relâché, presque un « é » fermé : ship, sit, live. Le i long [iː] est tendu et tenu : sheep, seat, leave. Les confondre change le mot : live (vivre) ≠ leave (partir)."
     },
     "exemples": [
      {
       "mot": "ship",
       "traduction": "le bateau"
      },
      {
       "mot": "sheep",
       "traduction": "le mouton"
      },
      {
       "mot": "sit",
       "traduction": "être assis"
      },
