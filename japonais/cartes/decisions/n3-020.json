{"id": "jmdict:1538900", "fr": "gratuit ; seulement", "fr_src": "jmdict", "fr_autres": ["ordinaire", "simplement", "mais"], "en": "free of charge", "en_autres": ["only", "merely", "ordinary"], "phrases": [], "verdict": "BON", "raison": "« gratuit » et « seulement » sont justes.", "note": "Trois emplois : ただで = gratuitement ; ただの人 = quelqu'un d'ordinaire ; ただ〜だけ = seulement.", "note_phrase": "Le lot ne propose aucune phrase.", "domaine": "mots_utiles"},
{"id": "jmdict:1596950", "fr": "combat ; bataille", "fr_src": "jmdict", "fr_autres": ["lutte", "conflit", "match"], "en": "battle", "en_autres": ["fight", "struggle", "match"], "phrases": [141339], "verdict": "BON", "raison": "Les gloses sont justes.", "note": "Aussi au figuré et en sport. La phrase 190931 (lutte contre le cancer) est écartée pour le sujet.", "domaine": "histoire_geo"},
