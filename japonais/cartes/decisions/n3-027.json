{"id": "jmdict:1582290", "fr": "lumière (lampe, torche)", "fr_src": "jmdict", "fr_autres": ["lampe", "lumière"], "en": "light", "en_autres": ["lamp"], "phrases": [226242], "verdict": "BON", "raison": "« lumière (lampe, torche) » est juste.", "note": "Une lumière artificielle (lampe, feu), distincte de 光. Lecture ひ, homonyme de 火 (feu) et 日 (jour) ; souvent lu あかり ou ともしび.", "domaine": "maison"},
