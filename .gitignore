
# Les lots de relecture sont derives de themes.json : une commande les
# refait. Les VERDICTS et la liste de divergences restent versionnes.
relecture/lot_*.json

# Cache Python du dossier de tests
tests/__pycache__/

# Codes de secours et secrets : ce dossier n'etait pas ignore, seulement
# "non suivi" -- un seul "git add -A" les aurait pousses sur un depot public.
EUIPO/backup_codes.txt
*backup_codes*
*.secret

# Audio : le manifeste est derive des JSON (python audio/manifest.py --ecrire),
# et les MP3 se comptent en centaines de megaoctets. Ni l'un ni l'autre n'a sa
# place dans un depot synchronise par OneDrive -- les fichiers vont sur
# Firebase Storage, seuls les scripts sont versionnes.
audio/manifest.json
audio/mp3/
audio/essai/
audio/__pycache__/

# Cache de deploiement de firebase-tools (hachages des 5260 mp3 deposes).
# Se refait tout seul, et grossit a chaque depot.
.firebase/

# Copie des mp3 tels que sortis d ElevenLabs, avant normalisation.
# Irremplaçables sans repayer la generation : a garder, jamais a versionner.
audio/mp3_original/
audio/essai_norm/
