
# Les lots de relecture sont derives de themes.json : une commande les
# refait. Les VERDICTS et la liste de divergences restent versionnes.
relecture/lot_*.json

# Cache Python du dossier de tests
tests/__pycache__/

# Codes de secours et secrets : ce dossier n'etait pas ignore, seulement
# "non suivi" -- un seul "git add -A" les aurait pousses sur un depot public.
EUIPO/backup_codes.txt
*backup_codes*
*.secret

# Audio : le manifeste est derive des JSON (python audio/manifest.py --ecrire),
# et les MP3 se comptent en centaines de megaoctets. Ni l'un ni l'autre n'a sa
# place dans un depot synchronise par OneDrive -- les fichiers vont sur
# Firebase Storage, seuls les scripts sont versionnes.
audio/manifest.json
audio/mp3/
audio/essai/
audio/__pycache__/

# Cache de deploiement de firebase-tools (hachages des 5260 mp3 deposes).
# Se refait tout seul, et grossit a chaque depot.
.firebase/

# Copie des mp3 tels que sortis d ElevenLabs, avant normalisation.
# Irremplaçables sans repayer la generation : a garder, jamais a versionner.
audio/mp3_original/
audio/essai_norm/

# Lots de relecture turque : derives des JSON, une commande les refait.
# Les verdicts, collisions.md, suspects.md et divergences_tr.md restent versionnes.
relecture_tr/*_lot_*.json
relecture_tr/*_lot_*.txt

# Cache des retraductions DeepL : derive du corpus, se refait, et pese lourd.
relecture_tr/cache-deepl.json

# Listes officielles des examens : PDF du Goethe-Institut et extractions.
# Libres d acces pour les apprenants, mais ce depot est PUBLIC -- on ne les
# redistribue pas. Le script tests/listes_examen.py les retelecharge.
examens/

# Correspondance numero -> nom des testeurs : donnees personnelles, depot PUBLIC.
# Le journal (retours/journal-retours.md) ne nomme personne et reste versionne.
retours/cle-testeurs.txt

# Bascule vers la voix Aurora, 4 septembre 2026 : les artefacts de l'ancienne
# voix, mis de cote pour pouvoir revenir en arriere. Des centaines de Mo, et
# un « git add -A » distrait suffirait a les pousser sur un depot PUBLIC.
audio/mp3_nadja/
audio/nadja--*
audio/essai_nadja/
audio/essai_seuil/
audio/mp3_porteuse_brut/

# Sources et rushes video : ils restent sur le disque, jamais publies.
# Un « git add -A video » les a pousses par erreur le 6 septembre 2026 --
# ils ont ete depublies dans l'heure. Cette regle empeche que ca recommence.
video/*.MOV
video/manga.JPG
video/Prep*.jpeg
video/FinalOuverture.MP4
video/Nouveauvideoouverture.MP4
video/ouverture-3s.avant-v362.mp4
