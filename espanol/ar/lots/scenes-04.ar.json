{
 "sportplatz|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "sportplatz|A2|0": "<b>la</b> مؤنث ← <b>en la</b>.",
 "sportplatz|A2|1": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "sportplatz|A2|2": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "sportplatz|A2|3": "<b>la</b> مؤنث ← <b>en la</b>.",
 "sportplatz|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "sportplatz|A2|5": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "sportplatz|A2|6": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "sportplatz|A2|7": "<b>la</b> مؤنث ← <b>en la</b>.",
 "sportplatz|B1|titre": "Indefinido أم imperfecto؟",
 "sportplatz|B1|0": "فعل محدّد ← <b>indefinido</b>: marcó.",
 "sportplatz|B1|1": "<b>caer</b> → <b>cayó</b>: الـ i تصير y.",
 "sportplatz|B1|2": "هم ← <b>-ieron</b>: corrieron.",
 "sportplatz|B1|3": "فعلان محدّدان متتابعان ← <b>indefinido</b>.",
 "sportplatz|B1|4": "الخلفية، الوصف ← <b>imperfecto</b>: hacía.",
 "sportplatz|B1|5": "حالة تدوم في السرد ← <b>imperfecto</b>: estaban.",
 "sportplatz|B1|6": "<b>empezar</b> → empezó، في لحظة محدّدة.",
 "sportplatz|B1|7": "النتيجة النهائية ← <b>indefinido</b>: ganó.",
 "sportplatz|B2|titre": "Indicativo أم subjuntivo بعد أداة الربط",
 "sportplatz|B2|0": "<b>porque</b> + indicativo: السبب واقعة.",
 "sportplatz|B2|1": "<b>aunque</b> + indicativo: واقعة حقيقية نسلّم بها.",
 "sportplatz|B2|2": "<b>para que</b> ← دائماً <b>subjuntivo</b>.",
 "sportplatz|B2|3": "<b>cuando</b> + مستقبل ← <b>subjuntivo</b>: cuando termine.",
 "sportplatz|B2|4": "<b>mientras</b> + واقعة متزامنة ← indicativo.",
 "sportplatz|B2|5": "<b>antes de que</b> ← دائماً subjuntivo؛ وفي الماضي: empezara.",
 "sportplatz|C1|titre": "الفرضيات والاحتمال",
 "sportplatz|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "sportplatz|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "sportplatz|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "sportplatz|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "strand|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "strand|A2|0": "<b>encima de</b> = على.",
 "strand|A2|1": "<b>detrás de</b> = خلف.",
 "strand|A2|2": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "strand|A2|3": "<b>la</b> مؤنث ← <b>en la</b>.",
 "strand|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "strand|A2|5": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "strand|A2|6": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "strand|A2|7": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "strand|B1|titre": "الـ pretérito indefinido",
 "strand|B1|0": "فعل منتهٍ، في لحظة محدّدة (ayer) → <b>indefinido</b>.",
 "strand|B1|1": "هي ← <b>-ó</b>، بعلامة النبر.",
 "strand|B1|2": "شراء محدّد ← <b>indefinido</b>: compró.",
 "strand|B1|3": "<b>tirar</b> → tiró.",
 "strand|B1|4": "<b>dormir</b> → <b>durmió</b>: الـ o تصير u.",
 "strand|B1|5": "<b>poner</b> شاذّ ← <b>puso</b>.",
 "strand|B1|6": "<b>salir</b> → salió.",
 "strand|B1|7": "مدة محدودة (todo el día) → <b>indefinido</b>: estuvo.",
 "strand|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "strand|B2|0": "جملة موصولة بلا فاصلة، فاعل ← <b>que</b>.",
 "strand|B2|1": "<b>cuyo</b> يطابق الشيء المملوك: la pelota → <b>cuya</b>.",
 "strand|B2|2": "حرف جرّ + أداة + <b>que</b>، بمطابقة la isla.",
 "strand|B2|3": "<b>estar</b> + اسم المفعول، بالمطابقة: el helado → comid<b>o</b>.",
 "strand|B2|4": "<b>se</b> غير الشخصية: «يُسبَح»، والفعل بالمفرد.",
 "strand|B2|5": "<b>cuyo</b> يطابق الشيء المملوك: las rayas → <b>cuyas</b>.",
 "strand|C1|titre": "الفرضيات والاحتمال",
 "strand|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "strand|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "strand|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "strand|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "supermarkt|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "supermarkt|A2|0": "<b>la</b> مؤنث ← <b>en la</b>.",
 "supermarkt|A2|1": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "supermarkt|A2|2": "<b>la</b> مؤنث ← <b>en la</b>.",
 "supermarkt|A2|3": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "supermarkt|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "supermarkt|A2|5": "<b>la</b> مؤنث ← <b>en la</b>.",
 "supermarkt|A2|6": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "supermarkt|A2|7": "<b>la</b> مؤنث ← <b>en la</b>.",
 "supermarkt|B1|titre": "المقارنة والتفضيل",
 "supermarkt|B1|0": "المقارنة: <b>más</b> + صفة + <b>que</b>.",
 "supermarkt|B1|1": "الصفة تطابق: la chica → pequeñ<b>a</b>.",
 "supermarkt|B1|2": "للعمر: <b>mayor</b> = أكبر سنّاً.",
 "supermarkt|B1|3": "<b>más</b> … <b>que</b>: الطرف الثاني يأتي بعد <b>que</b>.",
 "supermarkt|B1|4": "<b>bueno</b> شاذّة ← <b>mejor</b>.",
 "supermarkt|B1|5": "التفضيل: <b>el</b> + اسم + <b>más</b> + صفة + <b>de</b>.",
 "supermarkt|B1|6": "المقارنة: <b>más</b> + صفة + <b>que</b>.",
 "supermarkt|B2|titre": "المجاملة: condicional",
 "supermarkt|B2|0": "مجاملة: <b>condicional</b> → podría.",
 "supermarkt|B2|1": "<b>me gustaría</b> = أودّ (condicional من gustar).",
 "supermarkt|B2|2": "<b>¿Sería tan amable de…?</b>: condicional من ser.",
 "supermarkt|B2|3": "نصيحة: <b>yo en tu lugar</b> + condicional.",
 "supermarkt|B2|4": "مجاملة: <b>condicional</b> → podría.",
 "supermarkt|B2|5": "<b>me gustaría</b> = أودّ (condicional من gustar).",
 "supermarkt|C1|titre": "الفرضيات والاحتمال",
 "supermarkt|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "supermarkt|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "supermarkt|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "supermarkt|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "untersuchung-dos|A2|titre": "¿Dónde está? — الجسم",
 "untersuchung-dos|A2|0": "عضو من الجسم ← <b>أداة التعريف</b> (la espalda)، لا ضمير الملكية.",
 "untersuchung-dos|A2|1": "<b>al lado de</b> = بجانب.",
 "untersuchung-dos|A2|2": "<b>al lado de</b> + el trasero → al lado <b>del</b> trasero.",
 "untersuchung-dos|A2|3": "<b>entre</b> = بين.",
 "untersuchung-dos|A2|4": "<b>debajo de</b> = تحت، أسفل.",
 "untersuchung-dos|A2|5": "مع <b>la</b> (شيء محدّد) ← <b>estar</b>.",
 "untersuchung-dos|B1|titre": "تعليمات الطبيبة",
 "untersuchung-dos|B1|0": "<b>darse la vuelta</b> = يستدير. أمر usted: dé + se → <b>dese</b>.",
 "untersuchung-dos|B1|1": "<b>para que</b> (غاية) ← دائماً <b>subjuntivo</b>.",
 "untersuchung-dos|B1|2": "<b>poner</b> = يضع (شيئاً). <b>ponerse</b> = يلبس، يضع على نفسه.",
 "untersuchung-dos|B1|3": "الصفة تطابق: los brazos → <b>sueltos</b>.",
 "untersuchung-dos|B1|4": "<b>se</b> + فعل يطابق ما يُرى: las palmas → <b>ven</b>.",
 "untersuchung-dos|B1|5": "أمر usted: soltar → <b>suelte</b> (الـ o تصير ue).",
 "untersuchung-dos|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "untersuchung-dos|B2|0": "مبني للمجهول جارٍ: <b>estar siendo</b> + اسم المفعول.",
 "untersuchung-dos|B2|1": "<b>cuyo</b> يطابق la espalda → <b>cuya</b>.",
 "untersuchung-dos|B2|2": "<b>cuyo</b> يطابق el estetoscopio → <b>cuyo</b>، وإن كانت la médica مؤنثاً.",
 "untersuchung-dos|B2|3": "<b>antes de que</b> ← دائماً <b>subjuntivo</b>.",
 "untersuchung-dos|B2|4": "بعد <b>entre</b>: <b>los cuales</b> (أو los que).",
 "untersuchung-dos|B2|5": "حالة في اللحظة ← <b>estar</b> descalzo (حافي القدمين).",
 "untersuchung-dos|C1|titre": "الفرضيات والاحتمال",
 "untersuchung-dos|C1|0": "<b>deber de</b> + مصدر ماضٍ = استنتاج بشأن الماضي.",
 "untersuchung-dos|C1|1": "<b>si</b> + subjuntivo الماضي (doliera): فرضية مخالفة للواقع.",
 "untersuchung-dos|C1|2": "فرضية غير واقعية: <b>si</b> + subjuntivo الماضي، ثم condicional.",
 "untersuchung-dos|C1|3": "بعد <b>dicen que</b> → <b>indicativo</b> (ha estado).",
 "untersuchung-dos|C1|4": "<b>deberse a</b> = يعود إلى، يرجع سببه إلى. (<b>deber de</b> تعبّر عن افتراض.)",
 "untersuchung-dos|C1|5": "فرضية بشأن الماضي: <b>si</b> + الماضي التامّ من subjuntivo.",
 "untersuchung|A2|titre": "¿Dónde está? — الجسم",
 "untersuchung|A2|0": "<b>junto a</b> = بمحاذاة، قرب.",
 "untersuchung|A2|1": "<b>al lado de</b> = بجانب؛ de + el = <b>del</b>.",
 "untersuchung|A2|2": "<b>delante de</b> = أمام: لم يصعد عليه بعد.",
 "untersuchung|A2|3": "لأعضاء الجسم، تضع الإسبانية <b>أداة التعريف</b>، لا ضمير الملكية: الضمير <b>le</b> يقول أصلاً لمن.",
 "untersuchung|A2|4": "<b>junto a</b> = على طول، بمحاذاة.",
 "untersuchung|A2|5": "<b>en</b> el suelo = على الأرض. أما «encima» و«dentro» فتستلزمان <b>de</b>.",
 "untersuchung|A2|5|latam": "<b>en</b> el piso = على الأرض. أما «encima» و«dentro» فتستلزمان <b>de</b>.",
 "untersuchung|B1|titre": "تعليمات الطبيبة",
 "untersuchung|B1|0": "مخاطبة احترام (usted): أمر بـ <b>-e</b> لفعل منتهٍ بـ -ar → <b>respire</b>.",
 "untersuchung|B1|1": "مضارع، غائب: la médica <b>escucha</b>.",
 "untersuchung|B1|2": "<b>llevar</b> = يرتدي (ثوباً).",
 "untersuchung|B1|3": "أمر usted + ضمير ملتصق: <b>súbase</b> (علامة النبر تحفظ المقطع المنبور).",
 "untersuchung|B1|4": "<b>النهي</b> يأخذ subjuntivo: no se <b>mueva</b>.",
 "untersuchung|B1|5": "الطلب <b>من</b> شخص: مفعول غير مباشر ← <b>le</b>. وpedir que + subjuntivo.",
 "untersuchung|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "untersuchung|B2|0": "مبني للمجهول جارٍ: <b>estar siendo</b> + اسم المفعول.",
 "untersuchung|B2|1": "<b>cuyo</b> يطابق el pecho → <b>cuyo</b>.",
 "untersuchung|B2|2": "فاعل الجملة الموصولة ← <b>que</b>. <b>médica de cabecera</b> = طبيبة العائلة.",
 "untersuchung|B2|3": "Subirse <b>a</b> algo: a + la que → <b>a la que</b>. أما <b>quien</b> فلا تدلّ إلا على الأشخاص.",
 "untersuchung|B2|4": "فعل مقبل، بالمبني للمجهول: <b>ser</b> + اسم المفعول ← <b>será</b> medida.",
 "untersuchung|B2|5": "<b>mientras</b> + فعل = بينما. أما <b>durante</b> فتوضع قبل اسم.",
 "untersuchung|C1|titre": "الفرضيات والاحتمال",
 "untersuchung|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "untersuchung|C1|1": "احتمال ← <b>subjuntivo</b> (esté). بعد es seguro أو creo، يكون indicativo: está.",
 "untersuchung|C1|2": "بعد <b>dicen que</b> (نقل قول) ← <b>indicativo</b>.",
 "untersuchung|C1|3": "فرضية غير واقعية: <b>si</b> + subjuntivo الماضي (latiera)، ثم condicional.",
 "untersuchung|C1|4": "فرضية بشأن الماضي: <b>si</b> + الماضي التامّ من subjuntivo، ثم condicional الماضي.",
 "untersuchung|C1|5": "<b>cuanto más</b> …, <b>más</b> … = كلّما …، زاد ….",
 "waschsalon|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "waschsalon|A2|0": "<b>la</b> مؤنث ← <b>en la</b>.",
 "waschsalon|A2|1": "<b>la</b> مؤنث ← <b>en la</b>.",
 "waschsalon|A2|2": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "waschsalon|A2|3": "<b>la</b> مؤنث ← <b>en la</b>.",
 "waschsalon|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "waschsalon|A2|5": "<b>de + el = del</b>، دائماً.",
 "waschsalon|A2|6": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "waschsalon|A2|7": "<b>la</b> مؤنث ← <b>en la</b>.",
 "waschsalon|B1|titre": "subjuntivo بعد الشكّ",
 "waschsalon|B1|0": "<b>no creer que</b> → subjuntivo.",
 "waschsalon|B1|1": "<b>dudar que</b> → subjuntivo.",
 "waschsalon|B1|2": "<b>es posible que</b> → subjuntivo.",
 "waschsalon|B1|3": "<b>no es seguro que</b> → subjuntivo.",
 "waschsalon|B1|4": "<b>quizás</b> + subjuntivo = شكّ واضح.",
 "waschsalon|B1|5": "<b>no pensar que</b> → subjuntivo.",
 "waschsalon|B1|6": "<b>creer que</b> في الإثبات ← indicativo.",
 "waschsalon|B2|titre": "Cuando + subjuntivo: المستقبل",
 "waschsalon|B2|0": "<b>cuando</b> + فعل مقبل ← subjuntivo.",
 "waschsalon|B2|1": "<b>cuando</b> + فعل مقبل ← subjuntivo.",
 "waschsalon|B2|2": "<b>en cuanto</b> + فعل مقبل ← subjuntivo.",
 "waschsalon|B2|3": "<b>hasta que</b> + فعل مقبل ← subjuntivo.",
 "waschsalon|B2|4": "عادة (<b>siempre</b>) → indicativo، لا subjuntivo.",
 "waschsalon|B2|5": "<b>tan pronto como</b> + فعل مقبل ← subjuntivo.",
 "waschsalon|C1|titre": "الفرضيات والاحتمال",
 "waschsalon|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "waschsalon|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "waschsalon|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "waschsalon|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "winter|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "winter|A2|0": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "winter|A2|0|latam": "<b>de + el = del</b>، دائماً.",
 "winter|A2|1": "<b>la</b> مؤنث ← <b>en la</b>.",
 "winter|A2|2": "<b>delante de</b> = أمام.",
 "winter|A2|3": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "winter|A2|4": "<b>la</b> مؤنث ← <b>en la</b>.",
 "winter|A2|5": "<b>de + el = del</b>، دائماً.",
 "winter|A2|6": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "winter|A2|7": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "winter|B1|titre": "الضمائر: le وla وlos",
 "winter|B1|0": "الشعور بالبرد ← <b>tener</b> frío.",
 "winter|B1|1": "<b>quedar bien</b> لشخص (يليق به) ← <b>le</b>.",
 "winter|B1|2": "لمن؟ ← <b>le</b>، حتى مع «al muñeco» بعده.",
 "winter|B1|3": "مفعول به مباشر مذكر جمع ← <b>los</b>.",
 "winter|B1|4": "لمن؟ ← <b>le</b>.",
 "winter|B1|5": "ضمير الملكية وحده يطابق الشيء: las botas → <b>suyas</b>.",
 "winter|B1|6": "لمن؟ ← <b>le</b>.",
 "winter|B1|7": "مفعول به مباشر مؤنث (la escoba) → <b>la</b>.",
 "winter|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "winter|B2|0": "جملة موصولة بلا فاصلة، فاعل ← <b>que</b>.",
 "winter|B2|1": "<b>cuyo</b> يطابق الشيء المملوك: el abrigo → <b>cuyo</b>.",
 "winter|B2|2": "بعد حرف جرّ مركّب: <b>la cual</b>، بمطابقة la casa.",
 "winter|B2|3": "<b>cubrir</b> ← اسم مفعول شاذّ <b>cubierto</b>.",
 "winter|B2|4": "مبني للمجهول <b>ser</b> + اسم المفعول بالمطابقة: el camino → barrid<b>o</b>.",
 "winter|B2|5": "<b>estar</b> + اسم المفعول، بالمطابقة: la vela → encendid<b>a</b>.",
 "winter|C1|titre": "الفرضيات والاحتمال",
 "winter|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "winter|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "winter|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "winter|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "wohnzimmer|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "wohnzimmer|A2|0": "<b>encima de</b> = على. de + el = <b>del</b>: encima <b>del</b> armario.",
 "wohnzimmer|A2|1": "<b>debajo de</b> = تحت. المكان يُقال بـ <b>estar</b>.",
 "wohnzimmer|A2|2": "<b>en</b> = في، مكان الوجود. ويُقال أيضاً <b>dentro de</b>.",
 "wohnzimmer|A2|3": "<b>colgado de</b> = معلّق على. ويطابق: el paraguas → colgad<b>o</b>.",
 "wohnzimmer|A2|4": "<b>delante de</b> = أمام؛ <b>detrás de</b> = خلف.",
 "wohnzimmer|A2|5": "<b>entre</b> = بين، بلا «de»: entre el armario y el sofá.",
 "wohnzimmer|A2|6": "جمع ← <b>están</b>. de + el = <b>del</b>: debajo <b>del</b> sofá.",
 "wohnzimmer|A2|7": "<b>debajo de</b> = تحت.",
 "wohnzimmer|A2|8": "<b>colgado de</b> = معلّق على: el calcetín → colgad<b>o</b>.",
 "wohnzimmer|A2|9": "<b>encima de</b> = على. La pecera = حوض السمك.",
 "wohnzimmer|B1|titre": "hay وestar وser والضمائر",
 "wohnzimmer|B1|0": "لقول إن شيئاً موجود، بلا تحديده ← <b>hay</b> (لا يتغيّر).",
 "wohnzimmer|B1|1": "مع أداة التعريف (<b>los</b> globos) → <b>estar</b>، لا hay.",
 "wohnzimmer|B1|2": "مفعول به مباشر مؤنث (la taza) → <b>la</b>.",
 "wohnzimmer|B1|3": "مفعول به مباشر مذكر (el paraguas) → <b>lo</b>.",
 "wohnzimmer|B1|4": "مفعول به مباشر مؤنث جمع (las botellas) → <b>las</b>.",
 "wohnzimmer|B1|5": "خاصية (اللون) ← <b>ser</b>.",
 "wohnzimmer|B1|6": "حالة (dormido) ومكان ← <b>estar</b>.",
 "wohnzimmer|B1|7": "نتيجة، حالة ← <b>estar</b> + اسم المفعول بالمطابقة: abiert<b>a</b>.",
 "wohnzimmer|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "wohnzimmer|B2|0": "حرف جرّ + موصول: de <b>la que</b> (la lámpara). بلا الأداة، تكون «de que» خطأ.",
 "wohnzimmer|B2|1": "فاعل الجملة الموصولة ← <b>que</b>. أما <b>quien</b> فلا تعود إلا على شخص.",
 "wohnzimmer|B2|2": "<b>cuyo</b> = الذي… ـه (ملكية). يطابق الشيء المملوك: la cabeza → <b>cuya</b>.",
 "wohnzimmer|B2|3": "بعد حرف جرّ من كلمات عدّة (delante de)، نستعمل <b>la cual</b>.",
 "wohnzimmer|B2|4": "مبني للمجهول بـ <b>ser</b>: ser + اسم المفعول بالمطابقة (los globos → inflad<b>os</b>).",
 "wohnzimmer|B2|5": "مبني للمجهول للحالة: <b>estar</b> + اسم المفعول بالمطابقة. النتيجة تدوم.",
 "wohnzimmer|C1|titre": "الفرضيات والاحتمال",
 "wohnzimmer|C1|0": "<b>deber de</b> + مصدر = استنتاج: شبه مؤكَّد، بالنظر إلى البالونات.",
 "wohnzimmer|C1|1": "<b>podría</b> = ممكن، بلا دليل. أما <b>debe</b> فتكون يقيناً.",
 "wohnzimmer|C1|2": "شرط غير واقعي في الماضي (hubiera viajado)، ونتيجة في الحاضر ← condicional: <b>estaría</b>.",
 "wohnzimmer|C1|3": "توقّع ← المستقبل: <b>se enfadará</b>. و<b>cuando</b> + مستقبل تأخذ subjuntivo: vea.",
 "zug|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "zug|A2|0": "<b>en</b> = على، في. المكان ← <b>estar</b>.",
 "zug|A2|1": "<b>encima de</b> = فوق.",
 "zug|A2|2": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "zug|A2|3": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "zug|A2|4": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "zug|A2|5": "<b>de + el = del</b>، دائماً.",
 "zug|A2|6": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "zug|A2|7": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "zug|B1|titre": "في السفر: en وa وpor",
 "zug|B1|0": "وسيلة النقل ← <b>en</b> tren (لكن <b>a</b> pie).",
 "zug|B1|1": "الاتجاه ← <b>a</b>.",
 "zug|B1|2": "عبر ← <b>por</b>.",
 "zug|B1|3": "المرور، المسار ← <b>por</b>.",
 "zug|B1|4": "وضع شيء في مكان ← <b>en</b>.",
 "zug|B1|5": "مكان الوجود ← <b>en</b>.",
 "zug|B1|6": "مفعول به مباشر مذكر (el billete) → <b>lo</b>.",
 "zug|B1|6|latam": "مفعول به مباشر مذكر (el boleto) → <b>lo</b>.",
 "zug|B1|7": "مفعول به مباشر مؤنث (la bufanda) → <b>la</b>.",
 "zug|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "zug|B2|0": "جملة موصولة بلا فاصلة، فاعل ← <b>que</b>.",
 "zug|B2|1": "<b>cuyo</b> يطابق الشيء المملوك: la iglesia → <b>cuya</b>.",
 "zug|B2|2": "حرف جرّ + أداة + <b>que</b>، بمطابقة la mesa.",
 "zug|B2|3": "مبني للمجهول <b>ser</b> + اسم المفعول بالمطابقة: el billete → revisad<b>o</b>.",
 "zug|B2|3|latam": "مبني للمجهول <b>ser</b> + اسم المفعول بالمطابقة: el boleto → revisad<b>o</b>.",
 "zug|B2|4": "<b>estar</b> + اسم المفعول، بالمطابقة: el periódico → doblad<b>o</b>.",
 "zug|B2|5": "<b>se</b> غير الشخصية + مصدر ← الفعل بالمفرد.",
 "zug|C1|titre": "الفرضيات والاحتمال",
 "zug|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "zug|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "zug|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "zug|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>."
}
