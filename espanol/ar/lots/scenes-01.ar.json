{
 "apotheke|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "apotheke|A2|0": "<b>la</b> مؤنث ← <b>en la</b>.",
 "apotheke|A2|1": "<b>la</b> مؤنث ← <b>en la</b>.",
 "apotheke|A2|2": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "apotheke|A2|3": "<b>la</b> مؤنث ← <b>en la</b>.",
 "apotheke|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "apotheke|A2|5": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "apotheke|A2|6": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "apotheke|A2|7": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "apotheke|B1|titre": "التكرار والجرعة",
 "apotheke|B1|0": "<b>cada</b> + مفرد: cada ocho horas.",
 "apotheke|B1|1": "<b>vez</b> بالجمع ← dos <b>veces</b>.",
 "apotheke|B1|2": "<b>nunca</b> قبل الفعل: بلا «no».",
 "apotheke|B1|3": "<b>todos los días</b> = كل يوم.",
 "apotheke|B1|4": "<b>nunca</b> = أبداً؛ <b>nada</b> = لا شيء؛ <b>nadie</b> = لا أحد.",
 "apotheke|B1|5": "<b>¿con qué frecuencia?</b> = كم مرة؟",
 "apotheke|B1|6": "una vez <b>a la</b> semana = مرة في الأسبوع.",
 "apotheke|B2|titre": "الشرط الواقعي: si + المضارع",
 "apotheke|B2|0": "شرط واقعي: <b>si</b> + المضارع indicativo.",
 "apotheke|B2|1": "جواب الشرط في صيغة الأمر (usted): <b>vaya</b>.",
 "apotheke|B2|2": "بعد <b>si</b> الواقعية، لا subjuntivo مضارع أبداً: funciona.",
 "apotheke|B2|3": "جواب الشرط في المستقبل: <b>estará</b>.",
 "apotheke|B2|4": "شرط واقعي: <b>si</b> + المضارع indicativo.",
 "apotheke|B2|5": "جواب الشرط في صيغة الأمر (tú): <b>toma</b>.",
 "apotheke|C1|titre": "الفرضيات والاحتمال",
 "apotheke|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "apotheke|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "apotheke|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "apotheke|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "arztpraxis|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "arztpraxis|A2|0": "<b>encima de</b> = فوق، على. المكان ← <b>estar</b>.",
 "arztpraxis|A2|1": "<b>de + el = del</b>، دائماً.",
 "arztpraxis|A2|2": "<b>junto a</b> = قرب، بمحاذاة.",
 "arztpraxis|A2|3": "<b>al lado de</b> + el paciente → al lado <b>del</b> paciente.",
 "arztpraxis|A2|4": "مع <b>una</b> (شيء نكتشفه) ← <b>hay</b>.",
 "arztpraxis|A2|5": "مع <b>los</b> (أشياء محدّدة) ← <b>estar</b>، لا hay.",
 "arztpraxis|A2|6": "<b>en</b> = على، في: en la rodilla.",
 "arztpraxis|A2|7": "<b>detrás de</b> = خلف.",
 "arztpraxis|B1|titre": "الضمائر، وser وestar",
 "arztpraxis|B1|0": "مفعول به مباشر مؤنث (la pelota) → <b>la</b>.",
 "arztpraxis|B1|1": "مفعول به مباشر مذكر جمع (los zapatos) → <b>los</b>.",
 "arztpraxis|B1|2": "<b>estar sentado</b>: حالة، وضعية.",
 "arztpraxis|B1|3": "الابتسام <b>لـ</b> شخص: مفعول غير مباشر ← <b>le</b>. والإسبانية تكرّره عن طيب خاطر: le sonríe <b>a Mark</b>.",
 "arztpraxis|B1|4": "مكان الوجود ← <b>estar</b>.",
 "arztpraxis|B1|5": "مفعول به مباشر مؤنث (la tarjeta) → <b>la</b>.",
 "arztpraxis|B1|6": "الإصابة حالة ← <b>estar</b> herido.",
 "arztpraxis|B1|7": "<b>quitarse</b> = يخلع (ثيابه)؛ <b>ponerse</b> = يلبس. هو حافي القدمين: لقد خلعها.",
 "arztpraxis|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "arztpraxis|B2|0": "<b>cuyo</b> يطابق الشيء المملوك: la rodilla → <b>cuya</b>.",
 "arztpraxis|B2|1": "فاعل الجملة الموصولة ← <b>que</b>. أما <b>cuya</b> فتستلزم اسماً مملوكاً بعدها مباشرة.",
 "arztpraxis|B2|2": "الابتسام <b>a</b> alguien: a + el que → <b>al que</b>. ومع quien تكون «<b>a</b> quien»، بلا أداة.",
 "arztpraxis|B2|3": "بعد <b>encima de</b>: <b>la cual</b> (أو la que)، وأبداً que وحدها.",
 "arztpraxis|B2|4": "النتيجة (أحدهم أغلقها) ← <b>estar</b> + اسم المفعول.",
 "arztpraxis|B2|5": "حالة ناتجة ← <b>estar</b> puesta. أما «es puesta» فتكون الفعل نفسه، بالمبني للمجهول.",
 "arztpraxis|C1|titre": "الفرضيات والاحتمال",
 "arztpraxis|C1|0": "<b>deber de</b> + مصدر ماضٍ = استنتاج بشأن الماضي: لا بدّ أنه وقع.",
 "arztpraxis|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "arztpraxis|C1|2": "فرضية بشأن الماضي: <b>si</b> + الماضي التامّ من subjuntivo، ثم condicional الماضي.",
 "arztpraxis|C1|3": "بعد <b>dicen que</b> (نقل واقعة) ← <b>indicativo</b>.",
 "baeckerei|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "baeckerei|A2|0": "<b>la</b> مؤنث ← <b>en la</b>.",
 "baeckerei|A2|1": "<b>la</b> مؤنث ← <b>en la</b>.",
 "baeckerei|A2|2": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "baeckerei|A2|3": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "baeckerei|A2|4": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "baeckerei|A2|5": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "baeckerei|A2|6": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "baeckerei|A2|7": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "baeckerei|B1|titre": "التراكيب الفعلية",
 "baeckerei|B1|0": "<b>acabar de</b> + مصدر = فعل للتوّ.",
 "baeckerei|B1|1": "<b>seguir</b> + gerundio = يواصل.",
 "baeckerei|B1|2": "<b>estar</b> + gerundio = يفعل الآن.",
 "baeckerei|B1|3": "<b>ir a</b> + مصدر = المستقبل القريب.",
 "baeckerei|B1|4": "<b>volver a</b> + مصدر = يعيد الفعل.",
 "baeckerei|B1|5": "<b>acabar de</b> + مصدر = فعل للتوّ.",
 "baeckerei|B1|6": "<b>llevar</b> + مدة + gerundio = يفعل منذ.",
 "baeckerei|B1|7": "<b>tener que</b> + مصدر = يجب عليه.",
 "baeckerei|B2|titre": "الكلام غير المباشر",
 "baeckerei|B2|0": "<b>decir que</b> في المضارع ينقل واقعة ← indicativo.",
 "baeckerei|B2|1": "سؤال غير مباشر في المضارع ← indicativo.",
 "baeckerei|B2|2": "فعل القول في الماضي (<b>dijo</b>) → imperfecto.",
 "baeckerei|B2|3": "أمر منقول (<b>pedir que</b>) → subjuntivo.",
 "baeckerei|B2|4": "مستقبل منقول في الماضي ← <b>condicional</b>.",
 "baeckerei|B2|5": "<b>preguntar si</b> → indicativo.",
 "baeckerei|C1|titre": "الفرضيات والاحتمال",
 "baeckerei|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "baeckerei|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "baeckerei|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "baeckerei|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "bauernhof|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "bauernhof|A2|0": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "bauernhof|A2|1": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "bauernhof|A2|2": "<b>la</b> مؤنث ← <b>en la</b>.",
 "bauernhof|A2|3": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "bauernhof|A2|4": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "bauernhof|A2|5": "<b>la</b> مؤنث ← <b>en la</b>.",
 "bauernhof|A2|6": "<b>el</b> مذكر ← <b>en el</b>، ولا يُدمج أبداً.",
 "bauernhof|A2|7": "<b>de + el = del</b>، دائماً.",
 "bauernhof|B1|titre": "الأفعال الانعكاسية",
 "bauernhof|B1|0": "<b>reírse</b>: في الغائب ← <b>se</b>.",
 "bauernhof|B1|1": "<b>tumbarse</b> = يتمدّد؛ él → <b>se</b>.",
 "bauernhof|B1|2": "<b>sentarse</b> = يجلس؛ él → <b>se</b>.",
 "bauernhof|B1|3": "<b>agacharse</b> = ينحني، يجثو؛ él → <b>se</b>.",
 "bauernhof|B1|4": "nosotros → <b>nos</b>.",
 "bauernhof|B1|5": "tú → <b>te</b>، قبل الفعل.",
 "bauernhof|B1|6": "<b>ponerse</b> + ثوب: yo → <b>me</b>.",
 "bauernhof|B1|7": "<b>acercarse</b> = يقترب؛ ellas → <b>se</b>.",
 "bauernhof|B2|titre": "gustar والأفعال المشابهة",
 "bauernhof|B2|0": "من يُحبّ هو مفعول: <b>le</b> (له، لها) — كما في «تعجبه».",
 "bauernhof|B2|1": "<b>encantar</b> يعمل مثل gustar → <b>le</b>.",
 "bauernhof|B2|2": "جمع (a los niños) → <b>les</b>.",
 "bauernhof|B2|3": "a mí → <b>me</b>؛ فاعل الفعل هو الشيء المحبوب.",
 "bauernhof|B2|4": "a ti → <b>te</b>.",
 "bauernhof|B2|5": "<b>doler</b> يعمل مثل gustar → <b>le</b> duele.",
 "bauernhof|C1|titre": "الفرضيات والاحتمال",
 "bauernhof|C1|0": "<b>deber de</b> + مصدر = استنتاج.",
 "bauernhof|C1|1": "<b>puede que</b> = ربما، قد ← دائماً <b>subjuntivo</b>.",
 "bauernhof|C1|2": "<b>المستقبل</b> يعبّر عن افتراض بشأن الحاضر.",
 "bauernhof|C1|3": "<b>dicen que</b> ينقل قولاً مؤكَّداً ← <b>indicativo</b>.",
 "bibliothek|A2|titre": "¿Dónde está? — estar وحروف الجرّ",
 "bibliothek|A2|0": "<b>de + el = del</b>، دائماً.",
 "bibliothek|A2|1": "<b>de + el = del</b>، دائماً.",
 "bibliothek|A2|2": "<b>la</b> مؤنث ← <b>en la</b>.",
 "bibliothek|A2|3": "مذكر جمع: <b>de los</b> libros.",
 "bibliothek|A2|4": "<b>la</b> مؤنث: <b>de la</b>، بلا دمج. وحدها <b>de + el</b> تصير <b>del</b>.",
 "bibliothek|A2|5": "<b>la</b> مؤنث ← <b>en la</b>.",
 "bibliothek|A2|6": "<b>hay</b> يقدّم شيئاً جديداً؛ و<b>está</b> يحدّد مكان شيء معروف من قبل.",
 "bibliothek|A2|7": "<b>la</b> مؤنث ← <b>en la</b>.",
 "bibliothek|B1|titre": "الأفعال مع حروف الجرّ",
 "bibliothek|B1|0": "<b>pensar en</b> = يفكّر في.",
 "bibliothek|B1|1": "<b>soñar con</b> = يحلم بـ.",
 "bibliothek|B1|2": "<b>interesarse por</b> = يهتمّ بـ.",
 "bibliothek|B1|3": "<b>esperar a</b> + شخص: الـ <b>a</b> أمام الأشخاص.",
 "bibliothek|B1|4": "<b>acordarse de</b> = يتذكّر.",
 "bibliothek|B1|5": "<b>concentrarse en</b> = يركّز على.",
 "bibliothek|B1|6": "<b>tardar en</b> + مصدر = يستغرق وقتاً في.",
 "bibliothek|B2|titre": "الجمل الموصولة والمبني للمجهول",
 "bibliothek|B2|0": "جملة موصولة بلا فاصلة، فاعل ← <b>que</b>.",
 "bibliothek|B2|1": "<b>cuyo</b> يطابق الشيء المملوك: el pelo → <b>cuyo</b>.",
 "bibliothek|B2|2": "حرف جرّ + أداة + <b>que</b>، بمطابقة la estantería.",
 "bibliothek|B2|3": "<b>se</b> غير الشخصية: «لا يُتكلَّم»، والفعل بالمفرد.",
 "bibliothek|B2|4": "<b>estar</b> + اسم المفعول: leer → <b>leído</b>، بعلامة النبر.",
 "bibliothek|B2|5": "<b>estar</b> + اسم المفعول، بالمطابقة: la lámpara → encendid<b>a</b>.",
