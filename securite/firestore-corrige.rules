// Regles de securite Firestore du projet deutschai-b6fbb -- VERSION CORRIGEE
// DU 11 NOVEMBRE 2026 (audit de lancement, point 1). A COLLER TELLE QUELLE dans
//   https://console.firebase.google.com/project/deutschai-b6fbb/firestore/rules
// a la place de TOUT le texte present, puis « Publier ». Mode d'emploi et
// raisons : securite/REGLES-FIRESTORE.md. Une fois publiee, ce fichier
// remplace firestore.rules (la copie de ce qui est en ligne).
//
// Ce qui change par rapport aux regles du 30 oct. :
//  1. L'admin est reconnu par son identifiant de compte (uid), plus par son
//     adresse : l'uid ne se choisit pas et ne se reutilise pas.
//  2. Les resumes (ce que lit le tableau de bord admin) n'acceptent plus
//     n'importe quoi de la part de la personne : seulement les treize champs
//     que l'app y ecrit, chacun de son type et borne en taille, et l'adresse
//     doit etre celle du compte connecte (on ne peut plus se faire passer
//     pour un autre testeur dans le tableau).
//  3. Personne ne peut s'accorder lui-meme un acces : ni un essai (`essais`),
//     ni les chapitres VHS (`vhsChaptersEnabled`), ni l'abonnement offert
//     (`accesAVie`, `accesJusqua` : les testeurs gratuits a vie et les 4 mois
//     offerts). Seul l'admin les ecrit, dans `users` comme dans les resumes ;
//     dans les autres langues, la personne ne peut pas les poser non plus.
//  4. Le debut de l'essai de 7 jours (`essaiDebut`) s'ecrit UNE fois, et
//     seulement a l'heure du serveur (session de l'abonnement, section D de
//     abonnement/GUIDE-MAGASINS.md, fusionnee ici le 11 nov.).
//  5. Les documents de progression (users et les quatre autres langues)
//     n'acceptent plus que les cles que l'app y ecrit, chacune de son type
//     (12 nov. 2026, avec le mode sans compte) ; les petits champs sont bornes,
//     les gros ne le sont que par la limite de Firestore (voir plus bas).
// Un champ de droit d'acces AJOUTE plus tard doit entrer dans accesReserves(),
// sinon chacun peut se le poser.
// Tout le reste est identique : memes collections, memes lectures.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    // Le compte de Jacques (verifie le 11 nov. 2026 : c'est l'identifiant de
    // ses documents dans les dix collections). Un uid n'est pas un secret.
    function isAdmin() {
      return connecte() && request.auth.uid == 'SOq5GGdxLsXGVaJWLiS3thtNGLE2';
    }
    function proprietaire(uid) {
      return connecte() && request.auth.uid == uid;
    }

    // ---- Ce que seul l'admin accorde ----
    function accesReserves() {
      return ['essais', 'vhsChaptersEnabled', 'accesAVie', 'accesJusqua'];
    }
    function creeSansAccesReserves() {
      return !request.resource.data.keys().hasAny(accesReserves());
    }
    function modifieSansAccesReserves() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(accesReserves());
    }
    // Le debut de l'essai : ecrit une seule fois, par l'heure du serveur
    // (serverTimestamp() dans l'app), jamais une date choisie par le
    // telephone, jamais reecrit ni efface ensuite. (L'app garde de toute
    // facon le plus tot de essaiDebut et de la creation du compte.)
    function essaiDebutALaCreation() {
      return !('essaiDebut' in request.resource.data)
          || request.resource.data.essaiDebut == request.time;
    }
    // La date du LIEN d'une adresse a un compte cree sans compte (12 nov. 2026) :
    // comme essaiDebut, ecrite une fois, a l'heure du serveur, jamais changee.
    // C'est elle qui dit si un compte relie l'a ete avant la sortie.
    function lienALaCreation() {
      return !('adresseLieeLe' in request.resource.data)
          || request.resource.data.adresseLieeLe == request.time;
    }
    function lienALaModification() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adresseLieeLe'])
          || (!('adresseLieeLe' in resource.data)
              && request.resource.data.adresseLieeLe == request.time);
    }
    function essaiDebutALaModification() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['essaiDebut'])
          || (!('essaiDebut' in resource.data)
              && request.resource.data.essaiDebut == request.time);
    }

    // ---- Les documents de progression : ce que la personne y ecrit ----
    // (users, usuariosEs, usersEn, usersPt, usersJa ; 12 nov. 2026, avec le
    // mode sans compte : un uid s'obtient en un clic.) Les 41 cles de
    // syncProgressToCloud() dans index.html, puis celles de l'inscription, des
    // notifications, de la langue apprise, de l'essai et du lien d'adresse.
    // ⚠️ UNE CLE AJOUTEE A LA SAUVEGARDE DOIT L'ETRE ICI, sinon TOUTE la
    // sauvegarde de chacun est refusee, sans message. tests/verifier.py le
    // controle (securite/controle_cles.py) avant chaque push.
    // Les cles anciennes deja presentes (gender, langueImposee, l'ancien
    // `progress`) restent ; `progress` ne peut plus que s'effacer.
    function champsProgression() {
      return ['a1VoyageJson', 'appareil', 'badgesJson', 'dailyActivityDate',
              'dailyActivityToday', 'dailyGoalTarget', 'decouverteJson', 'email',
              'etoilesJson', 'gels', 'grammaire', 'journalFinsJson',
              'journalVersionJson', 'joursJson', 'langueInterface', 'masteredCount',
              'monVocabJson', 'mosaique', 'niveauSeance', 'parcoursJson',
              'phrasesRateesJson', 'placementJson', 'premiersPasJson', 'profilJson',
              'progress', 'progressJson', 'questionsSeance', 'retoursUsager',
              'seanceFinieDate', 'seancesJson', 'streak', 'streakJour',
              'synonymesEcartes', 'totalCount', 'tuilesJson', 'updatedAt',
              'versionNative', 'vocabCartes', 'vocabDemandes', 'vusCount', 'xp',
              // hors de la sauvegarde
              'firstName', 'inviteCode', 'createdAt', 'fcmToken', 'fcmTokenUpdatedAt',
              'langueApprise', 'essaiDebut', 'adresseLieeLe'];
    }
    // Les champs qui grandissent avec l'usage (stockage local recopie tel quel :
    // vocabulaire, retours, journal, progressJson...) ne sont bornes que par la
    // limite de Firestore (1 Mio par document) : une borne plus basse finirait
    // par refuser, en silence, la sauvegarde d'une personne assidue. Ni leur
    // type : ⚠️ Firestore n'evalue pas plus de 1 000 expressions par requete,
    // et une sauvegarde complete (41 cles) les depassait (banc du 12 nov.) --
    // TOUTE la sauvegarde etait alors refusee. Ne pas ajouter de controle ici
    // sans relancer le banc (cas « la sauvegarde reelle complete »).
    function texteOuNul(d, champ, max) {
      return !(champ in d) || d[champ] == null || (d[champ] is string && d[champ].size() <= max);
    }
    function dateOuNul(d, champ) {
      return !(champ in d) || d[champ] == null || d[champ] is timestamp;
    }
    function liste(d, champ, max) {
      return !(champ in d) || (d[champ] is list && d[champ].size() <= max);
    }
    // Bornes gardees : ce que « Reconstruire les resumes » recopie dans le
    // tableau de bord (adresse, prenom, appareil, compteurs). ⚠️ MARGE MESUREE
    // le 12 nov. (securite/essai-regles, cas « la sauvegarde reelle
    // complete ») : 10 controles de champ de plus passent, 15 font refuser
    // la sauvegarde complete (limite des 1 000 expressions). Une CLE de plus dans champsProgression()
    // ne coute presque rien (100 essayees) ; un CONTROLE de plus coute cher.
    function progressionValide(d) {
      // email : null pour un compte sans compte (user.email d'un anonyme).
      return texteOuNul(d, 'email', 254)
          && texte(d, 'firstName', 60)
          && texte(d, 'appareil', 40)
          && texte(d, 'langueInterface', 10)
          && nombre(d, 'masteredCount') && nombre(d, 'totalCount') && nombre(d, 'vusCount')
          && nombre(d, 'streak') && nombre(d, 'xp') && nombre(d, 'gels')
          && nombre(d, 'dailyActivityToday') && nombre(d, 'dailyGoalTarget')
          && nombre(d, 'questionsSeance')
          && dateOuNul(d, 'updatedAt') && dateOuNul(d, 'createdAt')
          && dateOuNul(d, 'fcmTokenUpdatedAt')
          && liste(d, 'vocabDemandes', 150) && liste(d, 'vocabCartes', 150);
    }
    function creeSaProgression() {
      return request.resource.data.keys().hasOnly(champsProgression())
          && !('progress' in request.resource.data)
          && progressionValide(request.resource.data);
    }
    function modifieSaProgression() {
      let touchees = request.resource.data.diff(resource.data).affectedKeys();
      return touchees.hasOnly(champsProgression())
          && (!touchees.hasAny(['progress']) || !('progress' in request.resource.data))
          && progressionValide(request.resource.data);
    }

    // ---- Les resumes : ce que la personne y ecrit elle-meme ----
    // La liste exacte de syncProgressToCloud() dans index.html. Un champ
    // ajoute la-bas doit l'etre ici, sinon son resume est refuse (sa
    // progression, elle, part quand meme : c'est un autre document).
    function champsResume() {
      return ['email', 'firstName', 'masteredCount', 'vusCount', 'totalCount',
              'streak', 'retoursUsager', 'vocabDemandes', 'synonymesEcartes',
              'langueInterface', 'appareil', 'versionNative', 'updatedAt'];
    }
    function texte(d, champ, max) {
      return !(champ in d) || (d[champ] is string && d[champ].size() <= max);
    }
    function nombre(d, champ) {
      return !(champ in d) || d[champ] == null
          || (d[champ] is number && d[champ] >= 0 && d[champ] <= 10000000);
    }
    // Le mode sans compte (12 nov. 2026) : un compte anonyme n'a pas d'adresse
    // dans son jeton ; son resume porte alors une adresse vide.
    function resumeValide(d) {
      return d.get('email', '') == request.auth.token.get('email', '')
          && texte(d, 'email', 254)
          && texte(d, 'firstName', 60)
          && nombre(d, 'masteredCount')
          && nombre(d, 'vusCount')
          && nombre(d, 'totalCount')
          && nombre(d, 'streak')
          && texte(d, 'retoursUsager', 20000)
          && (!('vocabDemandes' in d) || (d.vocabDemandes is list && d.vocabDemandes.size() <= 150))
          && texte(d, 'synonymesEcartes', 100000)
          && texte(d, 'langueInterface', 10)
          && texte(d, 'appareil', 20)
          && texte(d, 'versionNative', 10)
          && (!('updatedAt' in d) || d.updatedAt == null || d.updatedAt is timestamp);
    }
    function creeSonResume(uid) {
      return proprietaire(uid)
          && request.resource.data.keys().hasOnly(champsResume())
          && resumeValide(request.resource.data);
    }
    function modifieSonResume(uid) {
      return proprietaire(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsResume())
          && resumeValide(request.resource.data);
    }

    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Un code se consomme une seule fois, et celui qui le consomme ne peut
      // toucher qu'aux trois champs de sa consommation.
      allow update: if connecte()
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedBy']);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note']);
    }

    // ---- La progression allemande, et les acces accordes par l'admin ----
    match /users/{uid} {
      allow get: if proprietaire(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if proprietaire(uid) && creeSansAccesReserves() && essaiDebutALaCreation() && lienALaCreation()
                    && creeSaProgression();
      allow update: if proprietaire(uid) && modifieSansAccesReserves() && essaiDebutALaModification() && lienALaModification()
                    && modifieSaProgression();
      allow delete: if proprietaire(uid);
      // L'admin ne modifie QUE les acces chez autrui (pas la progression,
      // pas essaiDebut).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(accesReserves());
    }
    match /resumes/{uid} {
      allow get, list: if isAdmin();
      allow create: if creeSonResume(uid);
      allow update: if modifieSonResume(uid);
      allow delete: if proprietaire(uid);
      // « Reconstruire les resumes », les boutons VHS et essais.
      allow write: if isAdmin();
    }

    // ---- Les autres langues : meme modele (progression, puis resume) ----
    match /usuariosEs/{uid} {
      allow get: if proprietaire(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if proprietaire(uid) && creeSansAccesReserves() && creeSaProgression();
      allow update: if proprietaire(uid) && modifieSansAccesReserves() && modifieSaProgression();
      allow delete: if proprietaire(uid);
    }
    match /resumenesEs/{uid} {
      allow get, list: if isAdmin();
      allow create: if creeSonResume(uid);
      allow update: if modifieSonResume(uid);
      allow delete: if proprietaire(uid);
      allow write: if isAdmin();
    }

    match /usersJa/{uid} {
      allow get: if proprietaire(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if proprietaire(uid) && creeSansAccesReserves() && creeSaProgression();
      allow update: if proprietaire(uid) && modifieSansAccesReserves() && modifieSaProgression();
      allow delete: if proprietaire(uid);
    }
    match /resumesJa/{uid} {
      allow get, list: if isAdmin();
      allow create: if creeSonResume(uid);
      allow update: if modifieSonResume(uid);
      allow delete: if proprietaire(uid);
      allow write: if isAdmin();
    }

    match /usersEn/{uid} {
      allow get: if proprietaire(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if proprietaire(uid) && creeSansAccesReserves() && creeSaProgression();
      allow update: if proprietaire(uid) && modifieSansAccesReserves() && modifieSaProgression();
      allow delete: if proprietaire(uid);
    }
    match /resumesEn/{uid} {
      allow get, list: if isAdmin();
      allow create: if creeSonResume(uid);
      allow update: if modifieSonResume(uid);
      allow delete: if proprietaire(uid);
      allow write: if isAdmin();
    }

    match /usersPt/{uid} {
      allow get: if proprietaire(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if proprietaire(uid) && creeSansAccesReserves() && creeSaProgression();
      allow update: if proprietaire(uid) && modifieSansAccesReserves() && modifieSaProgression();
      allow delete: if proprietaire(uid);
    }
    match /resumesPt/{uid} {
      allow get, list: if isAdmin();
      allow create: if creeSonResume(uid);
      allow update: if modifieSonResume(uid);
      allow delete: if proprietaire(uid);
      allow write: if isAdmin();
    }
  }
}
